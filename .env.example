# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Vertex AI model endpoint location. Gemini 3 is served from the "global" endpoint.
GOOGLE_CLOUD_LOCATION=global
# Region for Cloud Run / BigQuery / Artifact Registry resources.
GOOGLE_CLOUD_REGION=us-central1

# Run the agent on Vertex AI (required by hackathon rules). Authenticate with ADC:
#   gcloud auth application-default login
# (No API key needed for the agent — leave GOOGLE_AI_API_KEY unset.)
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini 3 (hackathon: "built with Gemini 3"). Dev: gemini-3-flash-preview.
# Final/demo: gemini-3.1-pro-preview. Both require GOOGLE_CLOUD_LOCATION=global.
GEMINI_MODEL=gemini-3-flash-preview

# Fivetran MCP Transport
# "stdio" = run server as subprocess (local dev, no separate server needed)
# "sse"   = connect to Cloud Run HTTP server (production)
MCP_TRANSPORT=stdio

# Fivetran MCP Server URL (only used when MCP_TRANSPORT=sse)
FIVETRAN_MCP_URL=https://fivetran-mcp-xxx.run.app/sse
FIVETRAN_API_KEY=your-fivetran-api-key
FIVETRAN_API_SECRET=your-fivetran-api-secret

# BigQuery
BIGQUERY_DATASET=zeus_data

# Web Server
WEB_HOST=0.0.0.0
WEB_PORT=8000
